@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Core REQUIRED CONFIG)
find_dependency(Filesystem REQUIRED CONFIG)
find_dependency(stb_image REQUIRED CONFIG)
find_dependency(stb_image_write REQUIRED CONFIG)
set(_IO_PREVIOUS_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(tinyexr3 REQUIRED MODULE)
set(CMAKE_MODULE_PATH "${_IO_PREVIOUS_CMAKE_MODULE_PATH}")
find_dependency(ZLIB REQUIRED CONFIG)
find_dependency(PNG REQUIRED CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/IOTargets.cmake")